CHANNEL_URL=https://www.youtube.com/@BhajanMarg/videos
CHANNEL_SHORTS_URL=https://www.youtube.com/@BhajanMarg/shorts
CHANNEL_STREAMS_URL=https://www.youtube.com/@BhajanMarg/streams

QDRANT_URL=
QDRANT_COLLECTION=bhajan_marg_chunks_cloud_v1

# Local ingestion -> production sync target. Keep these only on your ingestion machine.
CLOUD_QDRANT_URL=
CLOUD_QDRANT_API_KEY=
CLOUD_QDRANT_COLLECTION=bhajan_marg_chunks_cloud_v1

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_ENABLED=false

DENSE_CANDIDATES=40
SPARSE_CANDIDATES=40
FUSED_CANDIDATES=50
FINAL_SOURCES=3
CONTEXT_NEIGHBORS=0

STRONG_EVIDENCE_THRESHOLD=0.72
RELATED_EVIDENCE_THRESHOLD=0.45
USE_LLM_EVIDENCE_JUDGE=true

DATA_DIR=./data
SQLITE_PATH=./data/bhajan.db
TRANSCRIPT_DIR=./data/transcripts
TEMP_DIR=./data/tmp

DAILY_UPDATE_ENABLED=false
DAILY_UPDATE_HOUR=2
DAILY_UPDATE_MINUTE=15
DAILY_SCAN_LATEST=40
TIMEZONE=Asia/Kolkata

SUBTITLE_LANGS=hi.*,en.*
WHISPER_FALLBACK=false
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

YTDLP_COOKIES_FROM_BROWSER=
ADMIN_TOKEN=replace-with-random-secret
APP_MODE=local
LLM_PROVIDER=ollama
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
QDRANT_API_KEY=
QDRANT_DENSE_MODEL=sentence-transformers/all-minilm-l6-v2
QDRANT_BM25_MODEL=qdrant/bm25
CORS_ORIGINS=*

LLM_TIMEOUT_SECONDS=35
CHAT_TIMEOUT_SECONDS=180
QDRANT_TIMEOUT_SECONDS=30
VALIDATE_ANSWER_CLAIMS=true

# V1.5 quality/version labels written into every user-testing case.
CORPUS_VERSION=Premanand Corpus V1.0
CHUNKING_VERSION=chunking-v1
RETRIEVAL_VERSION=retrieval-v1.5
EMBEDDING_VERSION=sentence-transformers/all-minilm-l6-v2
RERANKER_VERSION=gemini-semantic-reranker-v1
PROMPT_VERSION=answer-policy-v1.5
